# Database
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"

# JWT
SECRET_KEY="your-secret-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI — set ANTHROPIC_API_KEY to use Claude Haiku; otherwise GEMINI_API_KEY is used
ANTHROPIC_API_KEY=""
# Only needed when the key is not scoped to a workspace (e.g. "wrkspc_...")
ANTHROPIC_WORKSPACE_ID=""
GEMINI_API_KEY=""
